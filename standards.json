{
  "$comment": "Манифест стандартов dev-standards. JSON — валидный подсет YAML: так все скрипты остаются zero-dep. enforcement: script | model | hybrid; paths — glob-маппинг «изменённый файл → какие проверки запускать»; severity: error роняет strict-режим, warn — только замечание. Проверки без paths (tbd) запускаются из run-all/pre-commit и хуком по git commit. langs — ограничение языка для языковых проверок.",
  "version": "0.3.0",
  "standards": [
    {
      "id": "box-spec",
      "enforcement": "hybrid",
      "guidance": "skills/box-spec/SKILL.md",
      "summary": "Коробка начинается со спецификации + Doc as Code",
      "checks": [
        {
          "check": "check-api-spec",
          "paths": ["api-specification/**"],
          "severity": "warn"
        },
        {
          "check": "check-docs",
          "paths": ["api-specification/**", "README.md"],
          "severity": "warn"
        }
      ]
    },
    {
      "id": "component-tests",
      "enforcement": "hybrid",
      "guidance": "skills/component-tests/SKILL.md",
      "summary": "Компонентные тесты — исполняемая спецификация по формуле",
      "checks": [
        {
          "check": "check-component-tests",
          "paths": ["component-tests/**", "docs/design/**"],
          "severity": "warn"
        }
      ]
    },
    {
      "id": "modules",
      "enforcement": "hybrid",
      "guidance": "skills/modules/SKILL.md",
      "summary": "Модули: 1 вход/1 выход, valid-by-construction, ROP, чистое ядро vs I/O",
      "checks": [
        {
          "check": "check-modules",
          "paths": ["internal/**"],
          "severity": "warn"
        },
        {
          "check": "check-constructors",
          "paths": ["**/*.go"],
          "severity": "warn",
          "langs": ["go"],
          "trigger": "changed"
        }
      ]
    },
    {
      "id": "tbd",
      "enforcement": "hybrid",
      "guidance": "skills/tbd/SKILL.md",
      "summary": "Trunk-Based Development",
      "checks": [
        {
          "check": "check-tbd",
          "paths": [],
          "trigger": "git-commit",
          "severity": "warn"
        }
      ]
    },
    {
      "id": "release",
      "enforcement": "model",
      "guidance": "skills/release/SKILL.md",
      "summary": "SemVer по совместимости + feature toggles default OFF",
      "checks": []
    }
  ]
}
